{
  "name": "flyingmoo",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "node scripts/prepare-assets.cjs && tauri build --no-bundle && npm run build:bridge && node scripts/package-portable.cjs",
    "build:bridge": "cargo build --release --locked --manifest-path src-tauri/Cargo.toml --bin flyingmoo-tobii-bridge",
    "test": "node --test tests/*.test.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "prepare-assets": "node scripts/prepare-assets.cjs",
    "build:web": "node scripts/prepare-assets.cjs && node scripts/build-web.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.20"
  }
}
